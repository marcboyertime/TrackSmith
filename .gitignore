.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate
*.wav
# Direct Logic-native empirical runs are versioned evidence. Their run records
# hash every retained render and keep signal evidence distinct from fixtures.
!research/evaluation/logic-native-empirical-runs/**/*.wav
# Deterministic synthetic dry/candidate pairs are milestone evidence; their
# manifest hashes every file and explicitly excludes subjective claims.
!research/evaluation/production-mastery-v1/dsp-listening-fixtures/**/*.wav
fixtures/generated/*
!fixtures/generated/.gitkeep
*.jsonl
# This immutable, shipped candidate package is intentionally versioned. Keep
# every other JSONL corpus ignored.
!research/knowledge/community-vocal-quantization-v1/corpus/*.jsonl
!research/knowledge/community-vocal-quantization-v1/integration/*.jsonl
!research/knowledge/community-vocal-quantization-v1/research/*.jsonl
!research/knowledge/community-level-balancing-eq-v1/corpus/*.jsonl
!research/knowledge/community-level-balancing-eq-v1/integration/*.jsonl
!research/knowledge/community-level-balancing-eq-v1/research/*.jsonl
!research/knowledge/community-compression-arrangement-frequency-allocation-v1/corpus/*.jsonl
!research/knowledge/community-compression-arrangement-frequency-allocation-v1/integration/*.jsonl
!research/knowledge/community-compression-arrangement-frequency-allocation-v1/research/*.jsonl
!research/knowledge/community-reverb-delay-v1/corpus/*.jsonl
!research/knowledge/community-reverb-delay-v1/integration/*.jsonl
!research/knowledge/community-reverb-delay-v1/research/*.jsonl
!research/community_knowledge/packages/tracksmith-corpus-005-automation/corpus/*.jsonl
!research/community_knowledge/packages/tracksmith-corpus-005-automation/knowledge_candidates/*.jsonl
!research/community_knowledge/packages/tracksmith-corpus-005-automation/sources/*.jsonl
!research/community_knowledge/packages/tracksmith-corpus-005-automation/tests/*.jsonl
!research/community_knowledge/packages/tracksmith-corpus-006-saturation-transient-shaping/corpus/*.jsonl
!research/community_knowledge/packages/tracksmith-corpus-006-saturation-transient-shaping/knowledge_candidates/*.jsonl
!research/community_knowledge/packages/tracksmith-corpus-006-saturation-transient-shaping/sources/*.jsonl
!research/community_knowledge/packages/tracksmith-corpus-006-saturation-transient-shaping/tests/*.jsonl
# Stable TrackSmith package trees are immutable, shipped contract data. This is
# intentionally narrower than a repository-wide JSONL exception.
!research/community_knowledge/packages/tracksmith-corpus-*/**/*.jsonl
# Package 017 is an immutable, evaluation-only package. This narrow exception
# makes its reproducible test corpus versioned without unignoring other JSONL.
!research/tutor_quality/packages/tracksmith-corpus-017-golden-tutor-conversations-level-adaptation/**/*.jsonl
.DS_Store
tmp/
__pycache__/
*.pyc

# User-supplied research corpus. Keep local/copyrighted source material and
# mechanically generated text out of version control; track synthesis and tools.
research/extracted/
research/papers/*
!research/papers/README.md
research/analysis/text/
research/analysis/html-text/
research/analysis/rendered/
research/analysis/corpus-index.tsv
research/analysis/html-index.tsv
research/analysis/source-text-index.tsv
# Rights-restricted or large natural-audio datasets remain local. Track the
# acquisition/rights manifests, schemas, indexes, audits, and derived non-audio
# evidence under research/evaluation/production-mastery-v1 instead.
research/datasets/
# Local speech-to-text output is navigation-only copyrighted working material.
tmp/local-course-transcripts/
