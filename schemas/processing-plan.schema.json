{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/logic-audio-assistant/processing-plan-1.0.schema.json",
  "title": "Logic Audio Assistant Processing Plan",
  "type": "object",
  "additionalProperties": false,
  "x-implementedNodeTypes": ["inputTrim", "polarity", "highPass", "lowPass", "parametricEQ", "compressor", "expander", "deEsser", "softClipper", "saturation", "stereoWidth", "delay", "modulatedDelay", "reverb", "limiter", "outputTrim", "loudnessMatch", "meter"],
  "x-realtimeResourceLimits": {
    "maximumDelayNodeCount": 4,
    "maximumTotalDelayTimeMS": 4000,
    "maximumReverbNodeCount": 2,
    "maximumExpanderNodeCount": 4,
    "maximumSampleRateHz": 192000
  },
  "$comment": "The node enum is the stable serialized vocabulary. PlanValidator rejects enabled node types not listed in x-implementedNodeTypes and performs node-specific parameter, graph, lock, gain, snapshot, and sample-rate validation that JSON Schema cannot fully express. Delay resource accounting combines delay and modulatedDelay nodes; a modulatedDelay requests delayTimeMS plus modulationDepthMS.",
  "required": ["schemaVersion", "requestID", "sourceSnapshotID", "scope", "goals", "nodes", "outputConstraints"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestID": { "$ref": "#/$defs/uuid" },
    "sourceSnapshotID": { "$ref": "#/$defs/uuid" },
    "scope": { "$ref": "#/$defs/scope" },
    "goals": { "type": "array", "items": { "$ref": "#/$defs/goal" }, "maxItems": 32 },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" }, "maxItems": 32 },
    "outputConstraints": { "$ref": "#/$defs/outputConstraints" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "finiteNumber": { "type": "number" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "channelFormat", "sourceType"],
      "properties": {
        "kind": { "enum": ["pluginInput", "importedFile"] },
        "channelFormat": { "enum": ["mono", "stereo"] },
        "sourceType": { "enum": ["vocal", "vocalBus", "drums", "drumBus", "bass", "guitar", "keyboard", "synth", "fullMix", "reference", "unknown"] },
        "timeRangeSeconds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute", "direction", "strength", "locked"],
      "properties": {
        "attribute": { "enum": ["clarity", "warmth", "brightness", "harshness", "muddiness", "punch", "closeness", "width", "dynamicControl", "sibilance", "backgroundNoise", "tonalBalance", "loudness", "cymbalHarshness", "lowEnd"] },
        "direction": { "enum": ["increase", "decrease", "preserve", "doNotIncrease", "doNotDecrease"] },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "locked": { "type": "boolean" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "enabled", "parameters", "rationale", "confidence", "category", "locked"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "enum": ["inputTrim", "polarity", "highPass", "lowPass", "parametricEQ", "compressor", "expander", "deEsser", "softClipper", "saturation", "transientShaper", "stereoWidth", "midSideEQ", "delay", "modulatedDelay", "reverb", "limiter", "outputTrim", "loudnessMatch", "meter"] },
        "enabled": { "type": "boolean" },
        "parameters": { "$ref": "#/$defs/parameters" },
        "rationale": {
          "type": "string",
          "maxLength": 4096,
          "x-maxUTF8Bytes": 4096,
          "$comment": "PlanValidator enforces the normative 4096-byte UTF-8 limit; JSON Schema maxLength counts Unicode code points."
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "category": { "enum": ["corrective", "creative", "loudness"] },
        "locked": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["transientShaper", "midSideEQ"] } } },
          "then": { "properties": { "enabled": { "const": false } } }
        },
        {
          "if": { "properties": { "type": { "const": "inputTrim" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["gainDB"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "polarity" } } },
          "then": { "properties": { "parameters": { "maxProperties": 0 } } }
        },
        {
          "if": { "properties": { "type": { "const": "highPass" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["frequencyHz", "q"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "lowPass" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["frequencyHz", "q"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "parametricEQ" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["frequencyHz", "q", "gainDB"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "compressor" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["thresholdDB", "ratio", "attackMS", "releaseMS", "makeupGainDB", "kneeDB", "mix"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "expander" } } },
          "then": {
            "properties": { "parameters": { "propertyNames": { "enum": ["algorithmVersion", "thresholdDB", "ratio", "attackMS", "releaseMS", "holdMS", "hysteresisDB", "rangeDB", "mix"] } } },
            "if": { "properties": { "enabled": { "const": true } } },
            "then": { "properties": { "parameters": { "required": ["algorithmVersion"] } } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "deEsser" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["frequencyHz", "thresholdDB", "ratio", "attackMS", "releaseMS", "mix"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "softClipper" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["driveDB", "ceilingDB", "mix"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "saturation" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["driveDB", "mix"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "transientShaper" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["gainDB", "mix"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "stereoWidth" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["width", "mix"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "midSideEQ" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["frequencyHz", "q", "gainDB", "mix"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "delay" } } },
          "then": {
            "properties": { "parameters": { "propertyNames": { "enum": ["algorithmVersion", "delayTimeMS", "feedback", "damping", "stereoCrossfeed", "mix"] } } },
            "if": { "properties": { "enabled": { "const": true } } },
            "then": { "properties": { "parameters": { "required": ["algorithmVersion"] } } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "modulatedDelay" } } },
          "then": {
            "properties": { "parameters": { "propertyNames": { "enum": ["algorithmVersion", "delayTimeMS", "feedback", "damping", "mix", "modulationDepthMS", "modulationRateHz", "stereoPhaseDegrees"] } } },
            "if": { "properties": { "enabled": { "const": true } } },
            "then": { "properties": { "parameters": { "required": ["algorithmVersion"] } } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "reverb" } } },
          "then": {
            "properties": { "parameters": { "propertyNames": { "enum": ["algorithmVersion", "preDelayMS", "decayTimeSeconds", "roomSize", "damping", "diffusion", "mix"] } } },
            "if": { "properties": { "enabled": { "const": true } } },
            "then": { "properties": { "parameters": { "required": ["algorithmVersion"] } } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "limiter" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["ceilingDB", "releaseMS", "lookaheadMS"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "outputTrim" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["gainDB"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "loudnessMatch" } } },
          "then": { "properties": { "parameters": { "propertyNames": { "enum": ["gainDB"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "meter" } } },
          "then": { "properties": { "parameters": { "maxProperties": 0 } } }
        }
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gainDB": { "type": "number", "minimum": -60, "maximum": 24 },
        "frequencyHz": { "type": "number", "minimum": 10, "maximum": 24000 },
        "q": { "type": "number", "minimum": 0.1, "maximum": 20 },
        "thresholdDB": { "type": "number", "minimum": -80, "maximum": 0 },
        "ratio": { "type": "number", "minimum": 1, "maximum": 40 },
        "attackMS": { "type": "number", "minimum": 0.05, "maximum": 500 },
        "releaseMS": { "type": "number", "minimum": 1, "maximum": 5000 },
        "makeupGainDB": { "type": "number", "minimum": -24, "maximum": 24 },
        "ceilingDB": { "type": "number", "minimum": -24, "maximum": 0 },
        "kneeDB": { "type": "number", "minimum": 0, "maximum": 24 },
        "mix": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0, "maximum": 2 },
        "driveDB": { "type": "number", "minimum": 0, "maximum": 36 },
        "enabled": { "type": "number", "minimum": 0, "maximum": 1 },
        "lookaheadMS": { "const": 0 },
        "algorithmVersion": { "const": 1 },
        "delayTimeMS": { "type": "number", "minimum": 1, "maximum": 2000 },
        "feedback": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "damping": { "type": "number", "minimum": 0, "maximum": 1 },
        "stereoCrossfeed": { "type": "number", "minimum": 0, "maximum": 1 },
        "modulationDepthMS": { "type": "number", "minimum": 0, "maximum": 20 },
        "modulationRateHz": { "type": "number", "minimum": 0.05, "maximum": 5 },
        "stereoPhaseDegrees": { "type": "number", "minimum": 0, "maximum": 180 },
        "preDelayMS": { "type": "number", "minimum": 0, "maximum": 250 },
        "decayTimeSeconds": { "type": "number", "minimum": 0.1, "maximum": 8 },
        "roomSize": { "type": "number", "minimum": 0, "maximum": 1 },
        "diffusion": { "type": "number", "minimum": 0, "maximum": 1 },
        "holdMS": { "type": "number", "minimum": 0, "maximum": 1000 },
        "hysteresisDB": { "type": "number", "minimum": 0, "maximum": 24 },
        "rangeDB": { "type": "number", "minimum": 0, "maximum": 80 }
      }
    },
    "outputConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxTruePeakDB", "loudnessMatchPreview", "preserveMonoCompatibility", "maxAddedGainDB"],
      "properties": {
        "maxTruePeakDB": { "type": "number", "minimum": -24, "maximum": 0 },
        "loudnessMatchPreview": { "type": "boolean" },
        "preserveMonoCompatibility": { "type": "boolean" },
        "maxAddedGainDB": { "type": "number", "minimum": 0, "maximum": 24 }
      }
    }
  }
}
