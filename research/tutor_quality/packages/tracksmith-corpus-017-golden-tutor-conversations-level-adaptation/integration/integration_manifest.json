  "experience_level_contract": {
    "contract": "tracksmith-tutor-experience-level/1.0",
    "default": "amateur",
    "display_labels": {
      "amateur": "Amateur",
      "noob": "Noob",
      "pro": "Pro"
    },
    "explicit_selection_only": true,
    "field_name": "experience_level",
    "historical_transcript_is_immutable": true,
    "inference_allowed": false,
    "level_change_applies_to_future_turns_only": true,
    "levels": {
      "amateur": {
        "assumed_knowledge": "tracks, regions, inserts, sends, ordinary EQ/compression/automation vocabulary",
        "must_not": "be generic filler or merely average word counts",
        "scaffolding": "normal production language; grouped routine steps; practical cause/effect and tradeoff"
      },
      "noob": {
        "assumed_knowledge": "none",
        "must_not": "patronize, reduce reasoning quality, or dump possibilities",
        "scaffolding": "plain language; define only the needed term; verified click-by-click steps; short causal explanation and listening cue"
      },
      "pro": {
        "assumed_knowledge": "advanced signal flow, processing, routing, and Logic concepts",
        "must_not": "be cryptic or omit decisive cue, risk, stop, or rollback",
        "scaffolding": "concise hypothesis, confounds, discriminating test, edge cases; routine clicks omitted unless requested"
      }
    },
    "provider_context_policy": "Send only effective level ID and compact contract; never send golden expected responses.",
    "quality_invariants": [
      "same diagnosis quality",
      "same evidence threshold",
      "same safety and privacy",
      "same tool authority",
      "same one-experiment discipline",
      "same stop/undo quality",
      "same artistic standard",
      "same willingness to express uncertainty"
    ],
    "receipt_policy": "Record persistent level and temporary override used for each completed turn.",
    "temporary_overrides_do_not_persist": true,
    "ui_policy": "Persistent three-option selector in Tutor settings; optional compact secondary level pill/menu; exact visible labels Noob, Amateur, Pro; default Amateur."
  },
