{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "candidate_hypotheses": {
      "maxItems": 6,
      "minItems": 3,
      "type": "array"
    },
    "canonical_user_question": {
      "minLength": 8,
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "domain": {
      "enum": [
        "compression",
        "arrangement",
        "frequency_allocation"
      ]
    },
    "id": {
      "minLength": 3,
      "type": "string"
    },
    "logic_pro_steps": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 3,
      "type": "array"
    },
    "package_sequence": {
      "const": 3
    },
    "review_status": {
      "const": "candidate_not_yet_human_reviewed"
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array"
    },
    "subcategory": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "domain",
    "category",
    "canonical_user_question",
    "candidate_hypotheses",
    "recommended_first_experiment",
    "logic_pro_steps",
    "source_ids",
    "review_status",
    "package_sequence"
  ],
  "title": "TrackSmith Package 3 canonical Q&A",
  "type": "object"
}
